<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)publish/$(Configuration)/$(RuntimeIdentifier)/portable/</IntermediateOutputPath>
  </PropertyGroup>
</Project>
