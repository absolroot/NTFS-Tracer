<Window x:Class="JournalDesk.ChangeComparisonWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 Language="{Binding Language,Source={x:Static loc:L.Text}}" xmlns:loc="clr-namespace:JournalDesk" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JournalDesk"
 Title="{loc:Ui CompareChanges}" Width="1190" Height="630" MinWidth="550" MinHeight="440"
 WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Malgun Gothic" Background="{DynamicResource Desk.Canvas}"
 Foreground="{DynamicResource Desk.Text}" UseLayoutRounding="True" SizeChanged="WindowResized" KeyDown="WindowKeyDown">
 <Window.Resources>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Cell" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,0"/></Style>
  <Style x:Key="HelpLink" TargetType="ToggleButton">
   <Setter Property="Height" Value="22"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="6,0,0,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="{DynamicResource Desk.Link}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Hit" CornerRadius="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
     <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource Desk.Selected}"/><Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Hit" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
   <Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Different}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Desk.Link}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="TableHeight" Height="109"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="{DynamicResource Desk.Panel}" LastChildFill="True">
   <CheckBox x:Name="AllFields" DockPanel.Dock="Right" Content="{loc:Ui IncludeTechnicalFields}" Style="{DynamicResource Desk.CompactCheck}" MinHeight="26" VerticalAlignment="Center" Margin="8,0,10,0" Checked="ToggleFields" Unchecked="ToggleFields" AutomationProperties.Name="{loc:Ui CompareAllRecordFields}"/>
   <StackPanel Margin="10,8,0,8">
    <local:CopyText x:Name="Heading" TextWrapping="NoWrap" FontSize="17" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
    <local:CopyText x:Name="EventStamp" TextWrapping="NoWrap" Margin="0,2,0,0" Foreground="{DynamicResource Desk.Muted}" FontSize="12"/>
   </StackPanel>
  </DockPanel>
  <DataGrid Grid.Row="1" x:Name="Fields" ColumnHeaderStyle="{DynamicResource Desk.LogHeader}" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False" AutoGenerateColumns="False"
   SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" CanUserReorderColumns="False"
   MinRowHeight="26" ColumnHeaderHeight="27" RowHeaderWidth="0" Background="{DynamicResource Desk.Canvas}" BorderThickness="0"
   GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Desk.Hairline}" CanUserSortColumns="True"
   AutomationProperties.Name="{loc:Ui CompareFieldsBeforeAndAfter}" ClipboardCopyMode="IncludeHeader" SelectionChanged="FieldChanged" PreviewMouseLeftButtonUp="RestoreField" PreviewKeyDown="FieldKeyDown">
   <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
   
   <DataGrid.Columns>
    <DataGridTemplateColumn SortMemberPath="Label" Header="{loc:Ui Field}" ClipboardContentBinding="{Binding Label}" Width="Auto" MinWidth="118" MaxWidth="245"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <DockPanel Margin="7,0"><ToggleButton DockPanel.Dock="Right" x:Name="EvidenceLink" Content="{loc:Ui ShowEvidence}" Style="{StaticResource HelpLink}"
      IsChecked="{Binding IsPathEvidenceOpen, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type local:ChangeComparisonWindow}}}"
      Visibility="Collapsed" ToolTip="{Binding EvidenceTip}" AutomationProperties.Name="{loc:Ui ShowPathEvidence}"/>
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
     <DataTemplate.Triggers><DataTrigger Binding="{Binding IsParent}" Value="True"><Setter TargetName="EvidenceLink" Property="Visibility" Value="Visible"/></DataTrigger>
      <Trigger SourceName="EvidenceLink" Property="IsChecked" Value="True"><Setter TargetName="EvidenceLink" Property="Content" Value="{loc:Ui HideEvidence}"/></Trigger></DataTemplate.Triggers>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn SortMemberPath="BeforeText" Header="{loc:Ui Before}" Width="*" MinWidth="90" ClipboardContentBinding="{Binding BeforeText}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBlock Style="{StaticResource Cell}" Text="{Binding BeforeText}" ToolTip="{Binding BeforeTip}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn SortMemberPath="AfterText" Header="{loc:Ui After}" Width="*" MinWidth="90" ClipboardContentBinding="{Binding AfterText}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBlock Style="{StaticResource Cell}" Text="{Binding AfterText}" ToolTip="{Binding AfterTip}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="{loc:Ui Comparison}" Width="Auto" MinWidth="60" Binding="{Binding State}" ElementStyle="{StaticResource StatusText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2">
   <Border x:Name="PathPanel" Visibility="Collapsed" Background="{DynamicResource Desk.Inset}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,1,0,0" Padding="10,5">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="99">
     <ItemsControl x:Name="PathNotes" AutomationProperties.Name="{loc:Ui ParentFolderEvidence}"><ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="1,2">
       <local:CopyText Text="{Binding Title,Mode=OneWay}" FontWeight="SemiBold"/>
       <local:CopyText x:Name="EvidencePath" Text="{Binding Path,Mode=OneWay}" AutomationProperties.Name="{loc:Ui FullPathForThisEvidence}" IsReadOnly="True"
        Padding="0" MinHeight="0" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Desk.Text}"/>
       <local:CopyText Text="{Binding Explanation,Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,3"/>
      </StackPanel>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Path}" Value=""><Setter TargetName="EvidencePath" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </Border>
   <Border BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,1,0,1" Background="{DynamicResource Desk.Panel}">
   <DockPanel Margin="10,4"><CheckBox DockPanel.Dock="Right" x:Name="InspectBytes" Content="{loc:Ui InspectCursorValues}" Style="{DynamicResource Desk.CompactCheck}" MinHeight="26" VerticalAlignment="Center" Margin="8,0,0,0" Checked="InspectBytesChanged" Unchecked="InspectBytesChanged" ToolTip="{loc:Ui ReadBytesAndIntegersAtEachCursor}"/>
    <TextBlock DockPanel.Dock="Left" Text="Hex" ToolTip="{loc:Ui SourceBytesForBothRecords}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel x:Name="SidePicker" Visibility="Collapsed" Orientation="Horizontal" Margin="12,0,0,0">
     <RadioButton x:Name="ShowBefore" Content="{loc:Ui Before}" IsChecked="True" Checked="SideChanged" Margin="0,0,12,0"/>
     <RadioButton x:Name="ShowAfter" Content="{loc:Ui After}" Checked="SideChanged"/>
    </StackPanel>
   </DockPanel>
  </Border>
  </StackPanel>
  <Grid Grid.Row="3" x:Name="Panes" SizeChanged="WindowResized">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="Gutter" Width="1"/><ColumnDefinition x:Name="RightWidth"/></Grid.ColumnDefinitions>
   <DockPanel x:Name="BeforePanel" Margin="10,8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
     <local:CopyText DockPanel.Dock="Right" x:Name="BeforeRange" TextWrapping="NoWrap" Foreground="{DynamicResource Desk.Muted}" FontSize="12" Margin="7,0,0,0"/>
     <local:CopyText x:Name="BeforeField" TextWrapping="NoWrap" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
    <Grid><local:HexEvidenceView x:Name="BeforeHex" AutomationProperties.Name="{loc:Ui PreviousNameRecordBytes}"/><TextBlock x:Name="BeforeMissing" Style="{StaticResource Caption}" HorizontalAlignment="Center" Visibility="Collapsed" Text="{loc:Ui ThisRecordHasNoKnownByteRangeFor}" TextWrapping="Wrap"/></Grid>
   </DockPanel>
   <Border Grid.Column="1" Background="{DynamicResource Desk.Rule}"/>
   <DockPanel x:Name="AfterPanel" Grid.Column="2" Margin="10,8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
     <local:CopyText DockPanel.Dock="Right" x:Name="AfterRange" TextWrapping="NoWrap" Foreground="{DynamicResource Desk.Muted}" FontSize="12" Margin="7,0,0,0"/>
     <local:CopyText x:Name="AfterField" TextWrapping="NoWrap" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
    <Grid><local:HexEvidenceView x:Name="AfterHex" AutomationProperties.Name="{loc:Ui NewNameRecordBytes}"/><TextBlock x:Name="AfterMissing" Style="{StaticResource Caption}" HorizontalAlignment="Center" Visibility="Collapsed" Text="{loc:Ui ThisRecordHasNoKnownByteRangeFor}" TextWrapping="Wrap"/></Grid>
   </DockPanel>
  </Grid>
  <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Desk.Rule}" Background="{DynamicResource Desk.Panel}" Padding="10,4">
   <local:CopyText x:Name="Source" TextWrapping="NoWrap" Foreground="{DynamicResource Desk.Muted}" FontSize="12" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
  </Border>
 </Grid>
</Window>
