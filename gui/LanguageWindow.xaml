<Window x:Class="JournalDesk.LanguageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NTFS Tracer" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Icon="Assets/NtfsTracer.ico"
 Background="{DynamicResource Desk.Canvas}" Foreground="{DynamicResource Desk.Text}" FontFamily="Segoe UI, Malgun Gothic, Yu Gothic UI">
 <StackPanel Margin="20,16,20,12">
  <Label x:Name="Heading" Target="{Binding ElementName=Languages}" FontSize="17" FontWeight="SemiBold" Padding="0" Margin="0,0,0,8"/>
  <ListBox x:Name="Languages" MaxHeight="350" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="SelectLanguage" AutomationProperties.LabeledBy="{Binding ElementName=Heading}">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
     <Setter Property="Padding" Value="10,3"/><Setter Property="MinHeight" Value="27"/>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBoxItem x:Name="SystemLanguage" Tag="system">
    <ListBoxItem.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBoxItem.ContentTemplate>
   </ListBoxItem>
  </ListBox>
  <TextBlock x:Name="SaveError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Desk.WarnText}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button x:Name="ExitButton" IsCancel="True" MinWidth="80" MinHeight="30" Padding="12,3"/>
   <Button x:Name="ContinueButton" Click="Confirm" IsDefault="True" Margin="8,0,0,0" MinWidth="80" MinHeight="30" Padding="12,3"
    Background="{DynamicResource Desk.Accent}" Foreground="{DynamicResource Desk.AccentText}" FocusVisualStyle="{StaticResource Desk.KeyboardOutline}">
    <Button.Template><ControlTemplate TargetType="Button">
     <Border x:Name="Plate" Padding="{TemplateBinding Padding}" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent" Background="{TemplateBinding Background}">
      <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Desk.Link}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.85"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Button.Template>
   </Button>
  </StackPanel>
 </StackPanel>
</Window>
