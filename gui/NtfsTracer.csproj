<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NtfsTracer</AssemblyName>
    <RootNamespace>JournalDesk</RootNamespace>
    <AssemblyTitle>Absolroot NTFS Tracer</AssemblyTitle>
    <Product>Absolroot NTFS Tracer</Product>
    <ApplicationIcon>Assets/NtfsTracer.ico</ApplicationIcon>
    <JournalIndexPath Condition="'$(JournalIndexPath)' == '' and '$(RuntimeIdentifier)' == 'win-x86'">../engine/target/i686-pc-windows-msvc/release/ntfstracer-cli.exe</JournalIndexPath>
    <JournalIndexPath Condition="'$(JournalIndexPath)' == ''">../engine/target/release/ntfstracer-cli.exe</JournalIndexPath>
    <Version>0.9.4</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../modules/EvidenceImage/EvidenceImage.csproj">
      <AdditionalProperties Condition="'$(RuntimeIdentifier)' != ''">EwfRuntimeIdentifier=$(RuntimeIdentifier)</AdditionalProperties>
    </ProjectReference>
    <Resource Include="$(ApplicationIcon)"/>
    <None Update="Notices/Fluent-System-Icons.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    <None Update="Notices/licenses/**/*" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    <None Include="../THIRD-PARTY-NOTICES.md" Link="Notices/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    <None Include="../LICENSE" Link="Notices/LICENSE" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    <InternalsVisibleTo Include="TrackerFields" />
    <InternalsVisibleTo Include="PathResolution" />
    <InternalsVisibleTo Include="GlobalLog" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <None Include="$(JournalIndexPath)" Link="ntfstracer-cli.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
    <None Include="../engine/sootmark-LICENSE.txt" Link="Notices/sootmark-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true"/>
  </ItemGroup>
</Project>
