<UserControl x:Class="JournalDesk.TimestampLeadsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:JournalDesk"
 Language="{Binding Language,Source={x:Static loc:L.Text}}" IsVisibleChanged="VisibilityChanged">
 <UserControl.Resources>
  <Style TargetType="DataGrid" BasedOn="{StaticResource Desk.LogTable}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionUnit" Value="FullRow"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserSortColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
  </Style>
  <Style x:Key="TimestampMono" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogMono}">
   <Setter Property="Padding" Value="7,0,5,0"/>
  </Style>
  <Style x:Key="TimestampValue" TargetType="TextBlock" BasedOn="{StaticResource TimestampMono}">
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="TimestampText" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogText}">
   <Setter Property="Padding" Value="7,0,5,0"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="72"/><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="*" MinHeight="112"/></Grid.RowDefinitions>
  <Border Style="{DynamicResource Desk.LogToolbar}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,0,1">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="{loc:Ui LeadType}" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBlock x:Name="LeadTypeName" VerticalAlignment="Center" FontWeight="SemiBold"/>
    <ContentControl Style="{DynamicResource Desk.CriteriaHelp}" AutomationProperties.HelpText="{Binding Content,ElementName=Criterion}">
       <ContentControl.ToolTip><ToolTip x:Name="Criterion" Style="{DynamicResource Desk.CriteriaToolTip}"/></ContentControl.ToolTip>
      </ContentControl>
   </StackPanel>
  </Border>
   <DataGrid Grid.Row="1" x:Name="Candidates" ColumnHeaderStyle="{DynamicResource Desk.LogHeader}" SelectionChanged="CandidateChanged" SizeChanged="CandidateTableSizeChanged">
   <DataGrid.Columns>
    <DataGridTextColumn x:Name="CandidateLsnColumn" Header="LSN" Binding="{Binding LsnText}" Width="146" MinWidth="146" ElementStyle="{StaticResource TimestampMono}"/>
    <DataGridTextColumn x:Name="CandidateMftColumn" Header="MFT" Binding="{Binding Slot}" Width="63" MinWidth="63" ElementStyle="{StaticResource TimestampMono}"/>
    <DataGridTextColumn x:Name="FieldColumn" Binding="{Binding Field}" Width="*" MinWidth="144" ElementStyle="{StaticResource TimestampText}"/>
    <DataGridTextColumn x:Name="BeforeColumn" Binding="{Binding Before}" Width="218" MinWidth="218" ElementStyle="{StaticResource TimestampValue}"/>
    <DataGridTextColumn x:Name="AfterColumn" Binding="{Binding After}" Width="218" MinWidth="218" ElementStyle="{StaticResource TimestampValue}"/>
    <DataGridTextColumn x:Name="DifferenceColumn" Binding="{Binding Difference}" Width="124" MinWidth="124" ElementStyle="{StaticResource TimestampMono}"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="1" x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="18"
             Foreground="{DynamicResource Desk.Muted}" IsHitTestVisible="False"/>
  <Border Grid.Row="2" Padding="8,2" Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,1,0,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <TextBlock x:Name="Range" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <Button x:Name="Previous" Click="PreviousClick" Style="{DynamicResource Desk.IconButton}" Content="&#xE76B;" ToolTip="{loc:Ui PreviousPage}" AutomationProperties.Name="{loc:Ui PreviousPage}"/>
     <Button x:Name="Next" Click="NextClick" Style="{DynamicResource Desk.IconButton}" Content="&#xE76C;" ToolTip="{loc:Ui NextPage}" AutomationProperties.Name="{loc:Ui NextPage}"/>
    </StackPanel>
    <loc:CopyText x:Name="Source" Margin="0,0,8,0" TextWrapping="NoWrap" Foreground="{DynamicResource Desk.Muted}"/>
   </DockPanel>
  </Border>
  <loc:PaneSplitter Grid.Row="3" Style="{DynamicResource Desk.RowSplitter}" HorizontalAlignment="Stretch"
                ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{loc:Ui ResizeSelectedRecordDetails}"/>
  <DockPanel Grid.Row="4">
   <DockPanel DockPanel.Dock="Top" Margin="8,3">
    <Button x:Name="OpenHex" DockPanel.Dock="Right" Click="OpenHexClick" Padding="8,3" Margin="4,0,0,0"/>
    <Button x:Name="OpenLsn" DockPanel.Dock="Right" Click="OpenLsnClick" Padding="8,3"/>
    <TextBlock Text="{loc:Ui SupportingRecords}" VerticalAlignment="Center" FontWeight="SemiBold"/>
   </DockPanel>
   <DataGrid x:Name="Evidence" DockPanel.Dock="Top" MaxHeight="103" ColumnHeaderStyle="{DynamicResource Desk.LogHeader}" SelectionChanged="EvidenceChanged"
             MouseDoubleClick="OpenHexFromMouse" PreviewKeyDown="OpenHexFromKey">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{loc:Ui LeadEvidenceRole}" Binding="{Binding Role}" Width="118" ElementStyle="{StaticResource TimestampText}"/>
     <DataGridTextColumn Header="LSN" Binding="{Binding Lsn}" Width="146" MinWidth="146" ElementStyle="{StaticResource TimestampMono}"/>
     <DataGridTextColumn Header="FILETIME" Binding="{Binding FileTime}" Width="172" ElementStyle="{StaticResource TimestampMono}"/>
     <DataGridTextColumn Header="{loc:Ui LeadSourceOffset}" Binding="{Binding PositionText}" Width="*" MinWidth="180" ElementStyle="{StaticResource Desk.LogMono}"/>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel DockPanel.Dock="Top" Margin="8,3">
    <ComboBox x:Name="Fragments" DockPanel.Dock="Right" DisplayMemberPath="OffsetText" SelectionChanged="FragmentChanged" MinWidth="145"/>
    <TextBlock x:Name="HexLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <loc:HexEvidenceView x:Name="Raw"/>
    </DockPanel>
 </Grid>
</UserControl>
