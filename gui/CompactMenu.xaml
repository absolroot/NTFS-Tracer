<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="Desk.ExportHeader">
   <StackPanel x:Name="ExportLabel" Orientation="Horizontal">
    <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=MenuItem}}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 6,0 L 6,8 M 2.5,4.5 L 6,8 9.5,4.5 M 1,11 L 11,11"/>
    <TextBlock Text="{Binding}" Margin="5,0,4,0" VerticalAlignment="Center"/>
    <Path Width="8" Height="5" Stretch="Uniform" VerticalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=MenuItem}}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 0,0 L 4,3 8,0"/>
   </StackPanel>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding IsEnabled,RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="False">
    <Setter TargetName="ExportLabel" Property="Opacity" Value="0.45"/>
   </DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 <ControlTemplate x:Key="MenuHeadingTemplate" TargetType="MenuItem">
  <Border x:Name="Face" Background="Transparent" CornerRadius="3" Padding="8,1" MinHeight="25">
   <Grid>
    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Face}"
           IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" AllowsTransparency="True">
     <Border Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="1" CornerRadius="4" Padding="3">
      <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},Path=Height}">
       <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
   <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Desk.Pressed}"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="MenuCommandTemplate" TargetType="MenuItem">
  <Border x:Name="Face" Background="Transparent" CornerRadius="2" MinHeight="25" Padding="4,1,10,1">
   <Grid VerticalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*" SharedSizeGroup="Label"/><ColumnDefinition Width="Auto" SharedSizeGroup="Keys"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Visibility="Hidden" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
    <TextBlock x:Name="More" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding ElementName=Face}" AllowsTransparency="True"
           Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}">
     <Border Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="1" CornerRadius="4" Padding="3">
      <ItemsPresenter Grid.IsSharedSizeScope="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
     </Border>
    </Popup>
    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0" Foreground="{DynamicResource Desk.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
  </Border>
  <ControlTemplate.Triggers>
   <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="More" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
   <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.5"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Template" Value="{StaticResource MenuCommandTemplate}"/>
  <Style.Triggers><Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Template" Value="{StaticResource MenuHeadingTemplate}"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
   <Border Margin="4,3" Height="1" Background="{DynamicResource Desk.Rule}"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
