<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JournalDesk">
 <DataTemplate x:Key="Desk.RecordUsn">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
   <TextBlock Text="USN" VerticalAlignment="Center" Foreground="{DynamicResource Desk.Muted}" Margin="0,0,4,0"/>
   <local:CopyText Text="{Binding Usn,Mode=OneWay}" AutomationProperties.Name="USN" VerticalAlignment="Center"
                   FontFamily="Consolas, Malgun Gothic" FontSize="12"/>
  </StackPanel>
 </DataTemplate>
 <Style x:Key="Desk.RecordIcon" TargetType="Image">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
  <Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="Desk.KeyboardOutline" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="1" BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource Desk.Accent}" IsHitTestVisible="False"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Desk.GridCell" TargetType="DataGridCell">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="6,3"/>
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Desk.ColumnGripper" TargetType="Thumb">
  <Setter Property="Width" Value="5"/><Setter Property="Cursor" Value="SizeWE"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Desk.LogHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
  <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="BorderThickness" Value="0,0,1,1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Padding" Value="7,0"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="MinHeight" Value="24"/>
  <Setter Property="SeparatorBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="SeparatorVisibility" Value="Visible"/>
  <Setter Property="ToolTip" Value="{Binding Content,RelativeSource={RelativeSource Self}}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader">
   <Grid SnapsToDevicePixels="True">
    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
      <Path x:Name="SortArrow" Grid.Column="1" Width="7" Height="4" Margin="4,0,0,0" Stretch="Fill" VerticalAlignment="Center" Visibility="Collapsed"
            Fill="{TemplateBinding Foreground}" Data="M 0,4 L 3.5,0 7,4 Z" IsHitTestVisible="False"/>
     </Grid>
    </Border>
    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Desk.ColumnGripper}"/>
    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Desk.ColumnGripper}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/><Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 7,0 3.5,4 Z"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="CanUserSort" Value="False">
    <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
   </Trigger>
   <Trigger Property="CanUserSort" Value="True"><Setter Property="Cursor" Value="Hand"/></Trigger>
   <MultiTrigger><MultiTrigger.Conditions>
    <Condition Property="CanUserSort" Value="True"/><Condition Property="IsMouseOver" Value="True"/>
   </MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Desk.Hover}"/></MultiTrigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="Desk.LogRow" TargetType="DataGridRow">
  <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Style.Triggers>
   <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource Desk.LogAlternate}"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Desk.LogCell" TargetType="DataGridCell" BasedOn="{StaticResource Desk.GridCell}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="Desk.LogTable" TargetType="DataGrid">
  <Setter Property="RowHeight" Value="23"/>
  <Setter Property="ColumnHeaderHeight" Value="26"/>
  <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Desk.Hairline}"/>
  <Setter Property="ColumnHeaderStyle" Value="{StaticResource Desk.LogHeader}"/>
  <Setter Property="RowStyle" Value="{StaticResource Desk.LogRow}"/>
  <Setter Property="CellStyle" Value="{StaticResource Desk.LogCell}"/>
 </Style>
 <Style x:Key="Desk.StripedLogTable" TargetType="DataGrid" BasedOn="{StaticResource Desk.LogTable}">
  <Setter Property="AlternationCount" Value="2"/>
 </Style>
 <Style x:Key="Desk.LogText" TargetType="TextBlock">
  <Setter Property="Padding" Value="7,0,25,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/>
 </Style>
 <Style x:Key="Desk.LogMono" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogText}">
  <Setter Property="FontFamily" Value="Consolas, Malgun Gothic"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
 <Style x:Key="Desk.LogNumber" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogMono}">
  <Setter Property="TextAlignment" Value="Right"/>
 </Style>
</ResourceDictionary>
