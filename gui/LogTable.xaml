<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JournalDesk">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceChrome.xaml"/><ResourceDictionary Source="TableHeader.xaml"/></ResourceDictionary.MergedDictionaries>
 <DataTemplate x:Key="Desk.RecordUsn">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
   <TextBlock Text="USN" VerticalAlignment="Center" Foreground="{DynamicResource Desk.Muted}" Margin="0,0,4,0"/>
   <local:CopyText Text="{Binding Usn,Mode=OneWay}" AutomationProperties.Name="USN" VerticalAlignment="Center"
                   FontFamily="Consolas, Malgun Gothic" FontSize="12"/>
  </StackPanel>
 </DataTemplate>
 <Style x:Key="Desk.RecordIcon" TargetType="Image">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
  <Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="Desk.GridCell" TargetType="DataGridCell">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="6,3"/>
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Desk.LogRow" TargetType="DataGridRow">
  <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Style.Triggers>
   <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource Desk.LogAlternate}"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Desk.LogCell" TargetType="DataGridCell" BasedOn="{StaticResource Desk.GridCell}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style x:Key="Desk.LogTable" TargetType="DataGrid">
  <Setter Property="RowHeight" Value="23"/>
  <Setter Property="ColumnHeaderHeight" Value="26"/>
  <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Desk.Hairline}"/>
  <Setter Property="ColumnHeaderStyle" Value="{StaticResource Desk.LogHeader}"/>
  <Setter Property="RowStyle" Value="{StaticResource Desk.LogRow}"/>
  <Setter Property="CellStyle" Value="{StaticResource Desk.LogCell}"/>
 </Style>
 <Style x:Key="Desk.StripedLogTable" TargetType="DataGrid" BasedOn="{StaticResource Desk.LogTable}">
  <Setter Property="AlternationCount" Value="2"/>
 </Style>
 <Style x:Key="Desk.LogText" TargetType="TextBlock">
  <Setter Property="Padding" Value="7,0,25,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/>
 </Style>
 <Style x:Key="Desk.LogMono" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogText}">
  <Setter Property="FontFamily" Value="Consolas, Malgun Gothic"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
 <Style x:Key="Desk.LogNumber" TargetType="TextBlock" BasedOn="{StaticResource Desk.LogMono}">
  <Setter Property="TextAlignment" Value="Right"/>
 </Style>
</ResourceDictionary>
