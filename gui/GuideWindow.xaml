<Window x:Class="JournalDesk.GuideWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JournalDesk"
 Title="{local:Ui UserGuide}" Width="810" Height="540" MinWidth="570" MinHeight="350" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI, Malgun Gothic, Yu Gothic UI" Background="{DynamicResource Desk.Canvas}" Foreground="{DynamicResource Desk.Text}"
 PreviewKeyDown="GuideKeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="155" MaxWidth="210"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,1,0" Padding="10,8">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
     <local:HintTextBox x:Name="TopicSearch" Hint="{local:Ui GuideSearch}" Style="{DynamicResource Desk.LogSearchInput}"
      TextChanged="FilterTopics" AutomationProperties.Name="{local:Ui GuideSearch}"/>
     <Button x:Name="ClearSearch" Click="ClearGuideSearch" ToolTip="{local:Ui ClearSearch}" AutomationProperties.Name="{local:Ui ClearSearch}">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Desk.ClearLogSearch}">
       <Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=TopicSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
      </Style></Button.Style>
     </Button>
    </Grid>
    <ListBox x:Name="Topics" AutomationProperties.Name="{local:Ui GuideTopics}" SelectionChanged="ShowTopic"
     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="29"/>
     </Style></ListBox.ItemContainerStyle>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <FlowDocumentScrollViewer x:Name="Reader" Background="{DynamicResource Desk.Canvas}" Foreground="{DynamicResource Desk.Text}"
    AutomationProperties.Name="{local:Ui UserGuide}" IsSelectionEnabled="True" IsToolBarVisible="False"
    IsTabStop="True" Focusable="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
   <TextBlock x:Name="NoTopics" Visibility="Collapsed" Margin="20,16" Text="{local:Ui GuideNoResults}" Foreground="{DynamicResource Desk.Muted}" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
