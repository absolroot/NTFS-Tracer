<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <Style x:Key="Desk.KeyboardOutline" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <Border Margin="1" BorderThickness="1" CornerRadius="3" BorderBrush="{DynamicResource Desk.Accent}" IsHitTestVisible="False"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <sys:Double x:Key="Desk.FormControlHeight">30</sys:Double>
 <CornerRadius x:Key="Desk.FormCorner">4</CornerRadius>
 <Thickness x:Key="Desk.FormRowPadding">12,8</Thickness>
 <Thickness x:Key="Desk.FormActionGap">8,0,0,0</Thickness>
 <Style x:Key="Desk.SettingsScrollContent" TargetType="Border">
  <Style.Triggers>
   <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Visible">
    <Setter Property="Padding" Value="0,0,16,0"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="Desk.SettingsSurface" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="CornerRadius" Value="{StaticResource Desk.FormCorner}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>
 <Style x:Key="Desk.SettingsRow" TargetType="Border">
  <Setter Property="Padding" Value="{StaticResource Desk.FormRowPadding}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
 </Style>
 <Style x:Key="Desk.SettingsHeading" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="FontSize" Value="17"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="Desk.FormButton" TargetType="Button">
  <Setter Property="MinHeight" Value="{StaticResource Desk.FormControlHeight}"/>
  <Setter Property="Padding" Value="12,2"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="Background" Value="{DynamicResource Desk.Inset}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
           BorderThickness="1" CornerRadius="{StaticResource Desk.FormCorner}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                      TextElement.Foreground="{TemplateBinding Foreground}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Desk.Link}"/>
    </Trigger>
    <Trigger Property="IsDefaulted" Value="True">
     <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/>
    </Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.85"/></Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter TargetName="Plate" Property="Background" Value="{DynamicResource Desk.Inset}"/>
     <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
     <Setter Property="Foreground" Value="{DynamicResource Desk.Disabled}"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Desk.FormPrimary" TargetType="Button" BasedOn="{StaticResource Desk.FormButton}">
  <Setter Property="Background" Value="{DynamicResource Desk.Accent}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.AccentText}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
 </Style>
 <Style x:Key="Desk.FormBrowse" TargetType="Button" BasedOn="{StaticResource Desk.FormButton}">
  <Setter Property="Margin" Value="{StaticResource Desk.FormActionGap}"/>
 </Style>
 <Style x:Key="Desk.FormPath" TargetType="TextBox">
  <Setter Property="MinHeight" Value="{StaticResource Desk.FormControlHeight}"/>
  <Setter Property="Padding" Value="8,2"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="CaretBrush" Value="{DynamicResource Desk.Text}"/>
  <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Desk.Rule}"/>
  <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Grid SnapsToDevicePixels="True">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource Desk.FormCorner}"/>
    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
    <Border x:Name="Underline" BorderThickness="0,0,0,2" CornerRadius="0,0,4,4"
            VerticalAlignment="Bottom" Height="3" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
  <Style x:Key="Desk.IconButton" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Width" Value="30"/>
   <Setter Property="Height" Value="27"/>
   <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Hit" Background="Transparent" BorderThickness="1" CornerRadius="3" BorderBrush="Transparent">
     <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="{TemplateBinding FontSize}"
       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource Desk.Pressed}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Desk.PathEvidence" TargetType="Expander">
   <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton x:Name="HeaderSite" HorizontalAlignment="Left" MinHeight="24" MaxWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{DynamicResource Desk.Link}" FocusVisualStyle="{StaticResource Desk.KeyboardOutline}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Hit" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="2,0">
        <DockPanel><TextBlock x:Name="Arrow" Text="&#xE76C;" DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
         <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.Foreground="{TemplateBinding Foreground}"/>
        </DockPanel>
       </Border><ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter x:Name="Details" Visibility="Collapsed" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </StackPanel><ControlTemplate.Triggers>
     <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="Desk.CopyDocument" TargetType="TextBox">
   <DockPanel Background="{TemplateBinding Background}">
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Desk.TabRule}" BorderThickness="0,0,0,1">
     <Button x:Name="PART_Copy" HorizontalAlignment="Right" Margin="0,0,4,0"
             Style="{StaticResource Desk.IconButton}" FontSize="12" Cursor="Arrow"/>
    </Border>
    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="{TemplateBinding Padding}"
                  HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
   </DockPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="PART_Copy" Property="IsEnabled" Value="False"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Desk.WorkspacePane" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Desk.TabRule}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="7"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Desk.WorkspaceTablePane" TargetType="Border" BasedOn="{StaticResource Desk.WorkspacePane}">
   <Setter Property="Padding" Value="3"/>
  </Style>
  <Style x:Key="Desk.SashDot" TargetType="Ellipse">
   <Setter Property="Width" Value="2"/>
   <Setter Property="Height" Value="2"/>
   <Setter Property="Margin" Value="1,0"/>
   <Setter Property="Fill" Value="{DynamicResource Desk.Muted}"/>
  </Style>
  <Style x:Key="Desk.PaneSplitter" TargetType="GridSplitter">
   <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
    <Grid Background="Transparent" SnapsToDevicePixels="True">
     <Border x:Name="ActiveRule" Height="1" VerticalAlignment="Center"
             Background="{DynamicResource Desk.Accent}" Visibility="Collapsed"/>
     <StackPanel x:Name="Grip" Orientation="Horizontal" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Opacity="0.58" IsHitTestVisible="False">
      <Ellipse Style="{StaticResource Desk.SashDot}"/>
      <Ellipse Style="{StaticResource Desk.SashDot}"/>
      <Ellipse Style="{StaticResource Desk.SashDot}"/>
     </StackPanel>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="ResizeDirection" Value="Columns">
      <Setter TargetName="Grip" Property="LayoutTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
      <Setter TargetName="ActiveRule" Property="Height" Value="Auto"/>
      <Setter TargetName="ActiveRule" Property="Width" Value="1"/>
      <Setter TargetName="ActiveRule" Property="HorizontalAlignment" Value="Center"/>
      <Setter TargetName="ActiveRule" Property="VerticalAlignment" Value="Stretch"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="ActiveRule" Property="Visibility" Value="Visible"/>
      <Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
     </Trigger>
     <Trigger Property="IsDragging" Value="True">
      <Setter TargetName="ActiveRule" Property="Visibility" Value="Visible"/>
      <Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
      <Setter TargetName="ActiveRule" Property="Visibility" Value="Collapsed"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Desk.StatusBar" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
   <Setter Property="Padding" Value="10,5"/>
  </Style>
  <Style x:Key="Desk.StatusText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Geometry x:Key="Desk.TabJoinFill">M 5.5,0 Q 5.5,5.5 0,5.5 L 0,6 7,6 7,0 Z</Geometry>
  <Geometry x:Key="Desk.TabJoinStroke">M 5.5,0 Q 5.5,5.5 0,5.5</Geometry>
  <ControlTemplate x:Key="Desk.TabJoin" TargetType="Control">
   <Grid>
    <Path Data="{StaticResource Desk.TabJoinFill}" Fill="{TemplateBinding Background}"/>
    <Path Data="{StaticResource Desk.TabJoinStroke}" Stroke="{DynamicResource Desk.TabRule}" StrokeThickness="1"/>
   </Grid>
  </ControlTemplate>
  <Style x:Key="Desk.ConnectedTab" TargetType="TabItem">
   <Setter Property="Background" Value="{DynamicResource Desk.Canvas}"/>
   <Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource Desk.KeyboardOutline}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Grid x:Name="HeaderSurface" Background="Transparent" SnapsToDevicePixels="True">
    <Border x:Name="Face" Margin="5,0" Background="Transparent" BorderBrush="Transparent"
            BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" SnapsToDevicePixels="True">
     <ContentPresenter x:Name="Label" ContentSource="Header" RecognizesAccessKey="True"
                       TextElement.Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Border>
    <Grid x:Name="Joins" Height="6" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
     <Control Width="7" HorizontalAlignment="Left" Background="{TemplateBinding Background}"
              Template="{StaticResource Desk.TabJoin}" Focusable="False"/>
     <Control Width="7" HorizontalAlignment="Right" Background="{TemplateBinding Background}"
              Template="{StaticResource Desk.TabJoin}" Focusable="False" RenderTransformOrigin="0.5,0.5">
      <Control.RenderTransform><ScaleTransform ScaleX="-1"/></Control.RenderTransform>
     </Control>
    </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <MultiTrigger>
      <MultiTrigger.Conditions>
       <Condition SourceName="HeaderSurface" Property="IsMouseOver" Value="True"/>
       <Condition Property="IsSelected" Value="False"/>
       <Condition Property="IsEnabled" Value="True"/>
      </MultiTrigger.Conditions>
      <Setter TargetName="Face" Property="Background" Value="{DynamicResource Desk.TabHover}"/>
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Desk.TabHoverText}"/>
     </MultiTrigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="Face" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
      <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Desk.TabRule}"/>
      <Setter TargetName="Joins" Property="Visibility" Value="Visible"/>
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Desk.Text}"/>
      <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Desk.Disabled}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Desk.SecondaryTab" TargetType="TabItem" BasedOn="{StaticResource Desk.ConnectedTab}">
   <Setter Property="MinWidth" Value="52"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="Padding" Value="10,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Grid x:Name="HeaderSurface" Background="Transparent">
     <Border x:Name="HoverFace" Margin="2" CornerRadius="3" Background="Transparent"/>
     <ContentPresenter x:Name="Label" ContentSource="Header" RecognizesAccessKey="True"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                       TextElement.Foreground="{TemplateBinding Foreground}"/>
     <Border x:Name="SelectionLine" Height="2" Margin="8,0" VerticalAlignment="Bottom"
             Background="{DynamicResource Desk.Accent}" Visibility="Hidden" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger SourceName="HeaderSurface" Property="IsMouseOver" Value="True">
      <Setter TargetName="HoverFace" Property="Background" Value="{DynamicResource Desk.Hover}"/>
     </Trigger>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible"/>
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Desk.Text}"/>
      <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
     </Trigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter TargetName="HoverFace" Property="Background" Value="Transparent"/>
      <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Desk.Disabled}"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Desk.WorkspaceTab" TargetType="TabItem" BasedOn="{StaticResource Desk.ConnectedTab}">
   <Setter Property="MinWidth" Value="102"/>
   <Setter Property="Padding" Value="11,4"/>
   <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
    Foreground="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/></DataTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
