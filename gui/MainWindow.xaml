    </DataGrid>
   </DockPanel>
   <GridSplitter Grid.Column="2" Grid.Row="1" x:Name="ProofSplitter" Style="{DynamicResource Desk.RowSplitter}" Height="5" Background="{DynamicResource Desk.Rule}" HorizontalAlignment="Stretch" Visibility="Collapsed" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{loc:Ui ResizeEvidencePane}"/>
   <Border Grid.Column="2" Grid.Row="2" x:Name="Inspector" Visibility="Collapsed" Background="{DynamicResource Desk.Panel}" Padding="10,2,10,3">
    <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
      <Button x:Name="NearbyHistory" Content="{loc:Ui NearbyRecords}" IsEnabled="False" Click="OpenNeighborhood" Style="{DynamicResource Desk.EvidenceLink}" MinHeight="24" ToolTip="{loc:Ui InspectChangesToOtherFilesAroundTheSelected}"/>
      <Button Content="&#xE711;" Margin="3,0,0,0" Style="{DynamicResource Desk.IconButton}" Click="HideInspector" ToolTip="{loc:Ui CollapseEvidencePaneEsc}" AutomationProperties.Name="{loc:Ui CollapseEvidencePane}"/>
     </StackPanel>
     <ContentControl DockPanel.Dock="Right" Focusable="False" Content="{Binding SelectedItem,ElementName=ProofPicker}" ContentTemplate="{StaticResource Desk.RecordUsn}"/>
     <TextBlock x:Name="ActionName" Text="{loc:Ui SourceRecord}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,8,0"/>
    </DockPanel>
    <ListView x:Name="ProofPicker" DockPanel.Dock="Top" Visibility="Collapsed" SelectionMode="Single"
              IsSynchronizedWithCurrentItem="False" SelectionChanged="ProofChanged" MouseDoubleClick="OpenRecordBytes"
              PreviewKeyDown="RecordKeyDown" SizeChanged="SizeProofColumns" Padding="0" Margin="0,0,0,3"
              Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.Name="{loc:Ui ChooseASourceRecord}" AutomationProperties.HelpText="{loc:Ui OpenSourceHexGesture}">
     <ListView.Resources>
      <Style x:Key="ProofHeader" TargetType="GridViewColumnHeader">
       <Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="0"/>
       <Setter Property="Padding" Value="5,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
       <Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="FontSize" Value="12"/>
       <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/>
       <Setter Property="Background" Value="{DynamicResource Desk.Panel}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader">
        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
         <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
       </ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="Role" Value="Padding"><Setter Property="Visibility" Value="Hidden"/></Trigger></Style.Triggers>
      </Style>
      <Style x:Key="ProofCell" TargetType="TextBlock">
       <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
       <Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/>
      </Style>
      <Style x:Key="ProofNumber" TargetType="TextBlock" BasedOn="{StaticResource ProofCell}">
       <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
      </Style>
     </ListView.Resources>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
      <Setter Property="Height" Value="22"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="AutomationProperties.HelpText" Value="{Binding RawReason}"/>
      <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0} · {1} · USN {2}">
       <Binding Path="RecordLabel"/><Binding Path="RecordedName"/><Binding Path="Usn"/>
      </MultiBinding></Setter.Value></Setter>
      <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
       <Border x:Name="Line" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Desk.Hairline}">
        <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding View.Columns,RelativeSource={RelativeSource AncestorType=ListView}}" VerticalAlignment="Center"/>
       </Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource Desk.Selected}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/></Trigger>
       </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
     </Style></ListView.ItemContainerStyle>
     <ListView.View><GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource ProofHeader}">
      <GridViewColumn x:Name="ProofReasonColumn" Header="{loc:Ui ChangeReason}" Width="158"><GridViewColumn.CellTemplate><DataTemplate>
       <TextBlock Style="{StaticResource ProofCell}" Text="{Binding ProofReason}" ToolTip="{Binding RawReason}"/>
      </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn x:Name="ProofNameColumn" Header="{loc:Ui RecordedName}" Width="280"><GridViewColumn.CellTemplate><DataTemplate>
       <DockPanel Margin="4,0,0,0"><Image DockPanel.Dock="Left" Source="{Binding Icon}" Style="{StaticResource Desk.RecordIcon}"/>
        <TextBlock Style="{StaticResource ProofCell}" Text="{Binding RecordedName}" ToolTip="{Binding RecordedName}"/></DockPanel>
      </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn x:Name="ProofUsnColumn" Header="USN" Width="108"><GridViewColumn.CellTemplate><DataTemplate>
       <TextBlock Style="{StaticResource ProofNumber}" Text="{Binding Usn}"/>
      </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn x:Name="ProofOffsetColumn" Header="{loc:Ui Offset}" Width="106"><GridViewColumn.CellTemplate><DataTemplate>
       <TextBlock Style="{StaticResource ProofNumber}" Text="{Binding Position,StringFormat=0x{0:X}}" ToolTip="{Binding RawLocation}"/>
      </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
     </GridView></ListView.View>
    </ListView>
     <TabControl Style="{DynamicResource Desk.InspectorTabs}" x:Name="EvidenceTabs" SelectionChanged="EvidenceTabChanged" Background="Transparent" BorderThickness="0">
      <TabItem Header="{loc:Ui Overview}"><local:RecordOverviewView x:Name="OverviewPanel"/></TabItem>
      <TabItem x:Name="DetailsTab" Header="{loc:Ui RecordDetails}"><local:RecordDetailsView x:Name="Technical" AutomationProperties.Name="{loc:Ui JournalRecordFields}"/></TabItem>
      <TabItem x:Name="OriginalBytesTab" Header="Hex" ToolTip="{loc:Ui SourceBytes}"><DockPanel>
       <DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" x:Name="DetachHistory" IsEnabled="False" Click="DetachEvidence" Style="{DynamicResource Desk.OpenInWindow}" ToolTip="{loc:Ui OpenSourceInANewWindow}" AutomationProperties.Name="{loc:Ui OpenSourceInANewWindow}"/>
       <ContentControl Focusable="False" Content="{Binding SelectedItem, ElementName=ProofPicker}" ContentTemplate="{DynamicResource Desk.RawRecordHeader}"/></DockPanel>
       <local:HexEvidenceView x:Name="Hex" AutomationProperties.Name="{loc:Ui SourceBytes}"/>
      </DockPanel></TabItem>
      <TabItem x:Name="JsonTab" Header="JSON">
       <loc:CopyText x:Name="RecordJson" AutomationProperties.Name="JSON" FontFamily="Consolas" FontSize="13"
        TextWrapping="Wrap" VerticalAlignment="Stretch" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Margin="4,3"/>
      </TabItem>
     </TabControl></DockPanel></Border>
   <Border x:Name="Welcome" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{DynamicResource Desk.Canvas}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24"><Button Content="{loc:Ui OpenUsnJournalJ}" Click="Pick" HorizontalAlignment="Left"/></StackPanel></Border>
   </Grid></TabItem>
   <TabItem x:Name="TransactionTab" Grid.Column="2" Header="{loc:Ui NtfsTransactions}" Style="{StaticResource ModeTab}" ToolTip="{loc:Ui NtfsTransactionsCtrl3}">
    <DockPanel>
     <Button x:Name="BackToTimestampLeads" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="8,2"
             Content="{loc:Ui InvestigationTab}" Style="{DynamicResource Desk.EvidenceLink}"
             Visibility="Collapsed" Click="BackToTimestampLeadsClicked"/>
     <local:TransactionView x:Name="Transactions"/>
    </DockPanel>
   </TabItem>
   <TabItem x:Name="LeadsTab" Grid.Column="3" Header="{loc:Ui InvestigationTab}" Style="{StaticResource ModeTab}" ToolTip="{loc:Ui InvestigationTabShortcut}" IsEnabled="False">
    <TabControl x:Name="LeadSources" Style="{DynamicResource Desk.InspectorTabs}" BorderThickness="0">
     <TabItem x:Name="UsnLeads" Header="$UsnJrnl" IsEnabled="False"/>
     <TabItem x:Name="LogLeads" Header="$LogFile" IsEnabled="False"/>
    </TabControl>
   </TabItem>
   <TabItem x:Name="SettingsTab" Grid.Column="6" SizeChanged="FitWorkspaceTabs" Header="{loc:Ui IntakeSettingsTab}" MinWidth="84" Style="{StaticResource ModeTab}" ToolTip="{loc:Ui IntakeSettingsShortcut}" AutomationProperties.Name="{loc:Ui IntakeSettingsTab}">
    <TabItem.HeaderTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding}" VerticalAlignment="Center"/></StackPanel></DataTemplate></TabItem.HeaderTemplate>
    <local:IntakeSettings x:Name="Setup"/>
   </TabItem>
  </TabControl>
  <Grid x:Name="DropPreview" Visibility="Collapsed" IsHitTestVisible="False">
   <Border Background="{DynamicResource Desk.Canvas}" Opacity="0.65"/>
   <Border BorderBrush="{DynamicResource Desk.Accent}" BorderThickness="2" Margin="3" CornerRadius="3"/>
   <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Desk.Panel}"
     BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="1" CornerRadius="4" Padding="14,8">
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Desk.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock Text="{loc:Ui DropToReview}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </Border>
  </Grid>
  </Grid>
 </DockPanel>
</Window>
