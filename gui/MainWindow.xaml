       <Grid Margin="4,0" VerticalAlignment="Center" ToolTip="{Binding ClockDetail}"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Date}" FontFamily="Consolas" Foreground="{DynamicResource Desk.Muted}" VerticalAlignment="Center" FontSize="12"/>
        <TextBlock Grid.Column="1" Padding="0,0,22,0" Text="{Binding Clock}" FontFamily="Consolas" VerticalAlignment="Center"/></Grid>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="{loc:Ui Activity}" SortMemberPath="Label" ClipboardContentBinding="{Binding Label}" Width="126" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
       <TextBlock Margin="4,0" VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
