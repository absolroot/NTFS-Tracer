<Window x:Class="JournalDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 Language="{Binding Language,Source={x:Static loc:L.Text}}" xmlns:loc="clr-namespace:JournalDesk" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JournalDesk" Title="{loc:Ui JournaldeskNtfsFileAnalysis}" Width="1320" Height="840"
 MinWidth="760" MinHeight="530" WindowStartupLocation="CenterScreen" Icon="Assets/NtfsTracer.ico" FontFamily="Segoe UI, Malgun Gothic" Foreground="{DynamicResource Desk.Text}"
 Background="{DynamicResource Desk.Canvas}" AllowDrop="True" PreviewDragEnter="SourceDragOver" PreviewDragOver="SourceDragOver" PreviewDragLeave="SourceDragLeave" PreviewDrop="DropFile" PreviewKeyDown="Shortcuts">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <Style x:Key="Sub" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="RecordCountLink" TargetType="Button" BasedOn="{StaticResource Desk.EvidenceLink}">
   <Setter Property="Foreground" Value="{DynamicResource Desk.Muted}"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="MinHeight" Value="22"/>
   <Setter Property="Padding" Value="3,0"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Desk.Link}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{DynamicResource Desk.Link}"/></Trigger>
    <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="ModeTab" TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
   <Setter Property="MinWidth" Value="102"/><Setter Property="Padding" Value="16,4"/>
   <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
    Foreground="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/></DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Grid><Border x:Name="Plate" Background="{DynamicResource Desk.Panel}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Desk.Rule}"/>
     <ContentPresenter x:Name="TabTitle" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
     <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Background="Transparent"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Accent" Property="Background" Value="{DynamicResource Desk.Accent}"/><Setter TargetName="Plate" Property="Background" Value="{DynamicResource Desk.Canvas}"/><Setter TargetName="TabTitle" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/><Setter TargetName="Plate" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabTitle" Property="TextElement.Foreground" Value="{DynamicResource Desk.Disabled}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3,0,14"/></Style>
  <Style x:Key="PathValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Row" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Desk.Text}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7,2"/><Setter Property="Margin" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="Bg" Background="Transparent" CornerRadius="2"/><Border x:Name="Edge" HorizontalAlignment="Left" Width="2" Margin="0,3" CornerRadius="1"/>
     <ContentPresenter Margin="{TemplateBinding Padding}"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Desk.Hover}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Desk.Selected}"/><Setter TargetName="Edge" Property="Background" Value="{DynamicResource Desk.Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Desk.Accent}"/><Setter TargetName="Bg" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,0,1">
   <Menu x:Name="MainMenu" IsMainMenu="True" Background="Transparent" Padding="4,0" VerticalContentAlignment="Center" AutomationProperties.Name="{loc:Ui MainMenu}">
