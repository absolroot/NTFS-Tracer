    <MenuItem x:Name="FileMenu" Header="{loc:Ui File}">
     <MenuItem Header="{loc:Ui OpenSources}" Click="OpenSourcesDialog" InputGestureText="Ctrl+O" IsEnabled="{Binding IsEnabled,ElementName=Views}"/>
     <MenuItem x:Name="OpenJournalItem" Header="{loc:Ui OpenUsnJournal}" Click="Pick"/>
     <MenuItem x:Name="AttachMftItem" Header="{loc:Ui AttachMft}" IsEnabled="False" Click="PickMft"/>
     <MenuItem x:Name="OpenLogItem" Header="{loc:Ui OpenLogfile}" Click="PickLog"/>
     <Separator/>
     <MenuItem Header="{loc:Ui OpenInvestigation}" Click="OpenInvestigation"/>
     <MenuItem Header="{loc:Ui ResumeInvestigation}" Click="ResumeInvestigation"/>
     <MenuItem Header="{loc:Ui SaveInvestigation}" Click="SaveInvestigation"/>
     <Separator/>
     <MenuItem Header="{loc:Ui OpenTrackerResults}" Click="PickTrackerResult"/>
     <MenuItem x:Name="JournalInfoItem" Header="{loc:Ui SourceInformation}" IsEnabled="False" Click="OpenSourceInfo"/>
     <Separator/>
     <MenuItem Header="{loc:Ui EXit}" InputGestureText="Alt+F4" Click="ExitApplication"/>
    </MenuItem>
    <MenuItem Header="{loc:Ui Edit}">
     <MenuItem Header="{loc:Ui Copy}" Command="ApplicationCommands.Copy"/>
     <MenuItem Header="{loc:Ui SelectAll}" Command="ApplicationCommands.SelectAll"/>
     <Separator/>
     <MenuItem x:Name="FindItem" Header="{loc:Ui Find}" InputGestureText="Ctrl+F" Click="FindInView"/>
    </MenuItem>
    <MenuItem x:Name="ViewMenu" Header="{loc:Ui View}">
     <MenuItem x:Name="ShowGlobalItem" Header="{loc:Ui AllRecords}" InputGestureText="Ctrl+1" IsEnabled="{Binding IsEnabled, ElementName=GlobalTab}" IsChecked="{Binding IsSelected, ElementName=GlobalTab, Mode=OneWay}" Click="SelectWorkspace"/>
     <MenuItem x:Name="ShowHistoryItem" Header="{loc:Ui FileHistory}" InputGestureText="Ctrl+2" IsChecked="{Binding IsSelected, ElementName=HistoryTab, Mode=OneWay}" Click="SelectWorkspace"/>
     <MenuItem x:Name="ShowTransactionsItem" Header="{loc:Ui NtfsTransactions}" InputGestureText="Ctrl+3" IsChecked="{Binding IsSelected, ElementName=TransactionTab, Mode=OneWay}" Click="SelectWorkspace"/>
     <MenuItem x:Name="ShowLeadsItem" Header="{loc:Ui InvestigationTab}" InputGestureText="Ctrl+4" IsEnabled="{Binding IsEnabled, ElementName=LeadsTab}" IsChecked="{Binding IsSelected, ElementName=LeadsTab, Mode=OneWay}" Click="SelectWorkspace"/>
     <MenuItem x:Name="ShowSettingsItem" Header="{loc:Ui IntakeSettingsTab}" InputGestureText="Ctrl+," IsChecked="{Binding IsSelected, ElementName=SettingsTab, Mode=OneWay}" Click="SelectWorkspace"/>
     <Separator/>
     <MenuItem x:Name="MenuFullPaths" Header="{loc:Ui FullPaths}" ToolTip="{loc:Ui FullPathsTooltip}" IsCheckable="True" IsChecked="{Binding Enabled,Source={x:Static local:JournalPathPreference.Current},Mode=TwoWay}"/>
     <MenuItem x:Name="DarkTheme" Header="{loc:Ui DarkTheme}" IsCheckable="True" Click="ChangeTheme"/>
     <MenuItem x:Name="LanguageMenu" SubmenuOpened="ShowLanguageChoices" Header="{loc:Ui DisplayLanguage}">
      <MenuItem x:Name="SystemLanguage" Tag="system" Header="{loc:Ui UseWindowsLanguage}" Click="ChooseLanguage"/>
      <Separator/>
     </MenuItem>
    </MenuItem>
    <MenuItem x:Name="ToolsMenu" Header="{loc:Ui Tools}">
     <MenuItem Header="{loc:Ui FindUsnRemnantsLabel}" Click="OpenCarving"/>
     <MenuItem Header="{loc:Ui FindTransactionRemnants}" Click="OpenLogCarving"/>
    </MenuItem>
    <MenuItem Header="{loc:Ui Help}">
     <MenuItem Header="{loc:Ui UserGuide}" InputGestureText="F1" Click="OpenGuide"/>
     <Separator/>
     <MenuItem Header="{loc:Ui AboutJournaldesk}" Click="ShowAbout"/>
    </MenuItem>
   </Menu>
  </Border>
  <Border x:Name="JournalStatus" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,1,0,0" Background="{DynamicResource Desk.Panel}" Padding="10,5"><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{DynamicResource Desk.IconButton}" Content="&#xE71A;" Visibility="Collapsed" AutomationProperties.Name="{loc:Ui CancelAnalysis}" ToolTip="{loc:Ui CancelAnalysis}" Click="Cancel"/><TextBlock x:Name="Status" Style="{StaticResource Sub}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
  <Border x:Name="PairNoticeBorder" DockPanel.Dock="Top" Visibility="Collapsed" Padding="16,7" Background="{DynamicResource Desk.Warn}" BorderBrush="{DynamicResource Desk.WarnRule}" BorderThickness="0,0,0,1">
   <TextBlock x:Name="PairNotice" TextWrapping="Wrap" Foreground="{DynamicResource Desk.WarnText}" AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <Grid>
  <TabControl x:Name="Views" SelectionChanged="ChangeMode" SizeChanged="FitWorkspaceTabs" BorderThickness="0" Background="{DynamicResource Desk.Canvas}">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Desk.Inset}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,0,1"><Grid Grid.IsSharedSizeScope="True"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="PathPreferenceWidth"/><ColumnDefinition Width="Auto" SharedSizeGroup="SettingsWidth"/></Grid.ColumnDefinitions>
     <Grid Grid.ColumnSpan="3" IsItemsHost="True" KeyboardNavigation.TabNavigation="Local">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" SharedSizeGroup="PathPreferenceWidth"/><ColumnDefinition Width="Auto" SharedSizeGroup="SettingsWidth"/></Grid.ColumnDefinitions>
     </Grid>
     <CheckBox x:Name="WorkspaceFullPaths" Grid.Column="1" SizeChanged="FitWorkspaceTabs" Style="{StaticResource Desk.CompactCheck}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,12,0" IsChecked="{Binding Enabled,Source={x:Static local:JournalPathPreference.Current},Mode=TwoWay}" Content="{loc:Ui FullPaths}" ToolTip="{loc:Ui FullPathsTooltip}"/>
    </Grid></Border>
    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
   </DockPanel></ControlTemplate></TabControl.Template>
   <TabItem x:Name="GlobalTab" Header="{loc:Ui AllRecords}" Style="{StaticResource ModeTab}" ToolTip="{loc:Ui AllRecordsCtrl1}" IsEnabled="False">
    <local:GlobalLogView x:Name="GlobalView"/>
   </TabItem>
   <TabItem x:Name="HistoryTab" Grid.Column="1" Header="{loc:Ui FileHistory}" Style="{StaticResource ModeTab}" ToolTip="{loc:Ui FileHistoryCtrl2}">
   <Grid x:Name="Workspace">
   <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="185"/><RowDefinition Height="Auto"/><RowDefinition x:Name="EvidenceRow" Height="0"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="185" MaxWidth="640"/><ColumnDefinition Width="5"/><ColumnDefinition Width="2.55*" MinWidth="335"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource Desk.Panel}" Padding="8,8,7,5">
    <DockPanel><StackPanel DockPanel.Dock="Top" Margin="3,0,3,6">
     <Grid><loc:HintTextBox x:Name="Search" Hint="{loc:Ui SearchFileNames}" Style="{DynamicResource Desk.LogSearchInput}" TextChanged="SearchChanged" PreviewKeyDown="FileSearchKeyDown" AutomationProperties.Name="{loc:Ui SearchFileNames}" ToolTip="{loc:Ui SearchCurrentAndPreviousNamesCtrlF}"/>
      <Button FontSize="12" ToolTip="{loc:Ui ClearFileSearch}" AutomationProperties.Name="{loc:Ui ClearFileNameSearch}" Click="ClearFileSearch">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Desk.ClearLogSearch}"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      </Grid></StackPanel>
     <DockPanel DockPanel.Dock="Bottom" Margin="3,4,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="Prev" Style="{DynamicResource Desk.IconButton}" Content="&#xE76B;" ToolTip="{loc:Ui PreviousFilePage}" AutomationProperties.Name="{loc:Ui PreviousFilePage}" Click="Previous" IsEnabled="False"/><Button x:Name="Next" Style="{DynamicResource Desk.IconButton}" Content="&#xE76C;" Margin="3,0,0,0" ToolTip="{loc:Ui NextFilePage}" AutomationProperties.Name="{loc:Ui NextFilePage}" Click="Following" IsEnabled="False"/></StackPanel><TextBlock x:Name="PageInfo" VerticalAlignment="Center" Style="{StaticResource Sub}"/></DockPanel>
     <Grid><ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectFile" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{loc:Ui Files}">
      <ListBox.ItemTemplate><DataTemplate><DockPanel><Image Source="{Binding Icon}" Style="{StaticResource Desk.RecordIcon}" Width="20" Height="20" Margin="1,0,8,0" DockPanel.Dock="Left"/><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><local:JournalPathText Record="{Binding LastNamedRecord}" FileId="{Binding Id}" ShortText="{Binding Subtitle}" Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" Padding="0,0,22,0" ToolTipService.ShowDuration="20000"/><TextBlock Text="{Binding Disambiguator}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Disambiguator}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Sub}"><Style.Triggers><DataTrigger Binding="{Binding Disambiguator}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock x:Name="FileSearchEmpty" Text="{loc:Ui NoMatchingFiles}" Visibility="Collapsed" VerticalAlignment="Top" Margin="8,6" Style="{StaticResource Sub}" AutomationProperties.LiveSetting="Polite"/></Grid>
    </DockPanel></Border>
   <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Desk.Inset}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,1,0" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="{loc:Ui ResizeFileList}"/>
   <DockPanel Grid.Column="2" Visibility="{Binding ElementName=FileList,Path=HasItems,Converter={StaticResource BoolVis}}">
    <Border DockPanel.Dock="Top" Padding="12,7,10,6" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,0,0,1">
     <StackPanel><DockPanel><Menu DockPanel.Dock="Right" IsMainMenu="False" Background="Transparent" Padding="0" VerticalAlignment="Center">
       <Menu.Resources><ResourceDictionary Source="CompactMenu.xaml"/></Menu.Resources>
       <MenuItem x:Name="ExportButton" Header="{loc:Ui Export}" HeaderTemplate="{DynamicResource Desk.ExportHeader}" IsEnabled="False"
          ToolTip="{loc:Ui ExportAllSourceRecordsForTheSelectedFile}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{loc:Ui ExportSelectedFileHistory}">
        <MenuItem x:Name="ExportHistoryCsv" Header="{loc:Ui ExportAsCsv}" Click="Export"/>
       </MenuItem>
      </Menu>
      <Button x:Name="BackToLog" DockPanel.Dock="Left" Style="{DynamicResource Desk.EvidenceLink}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" Click="BackToLogClicked" ToolTip="{loc:Ui ReturnToSelectedJournalRecordAlt}" AutomationProperties.Name="{loc:Ui ReturnToSelectedJournalRecord}">
       <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE72B;" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{loc:Ui AllRecords}"/></StackPanel>
      </Button>
      <Button x:Name="BackToLeads" DockPanel.Dock="Left" Style="{DynamicResource Desk.EvidenceLink}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" Click="BackToLeadsClicked" ToolTip="{loc:Ui ReturnToLeadAlt}" AutomationProperties.Name="{loc:Ui ReturnToLeadAlt}">
       <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE72B;" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="{loc:Ui InvestigationTab}"/></StackPanel>
      </Button>
      <Image x:Name="SelectedIcon" Width="24" Height="24" Margin="0,0,8,0" DockPanel.Dock="Left" Visibility="Collapsed"/>
      <local:CopyText x:Name="FileTitle" Text="{loc:Ui SelectAFile}" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></DockPanel>
      <StackPanel x:Name="SnapshotPanel" Visibility="Collapsed" Margin="0,4,0,0">
       <DockPanel><TextBlock DockPanel.Dock="Left" Text="MFT" Style="{StaticResource Sub}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <local:CopyText DockPanel.Dock="Right" x:Name="SnapshotBasis" Foreground="{DynamicResource Desk.Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
        <local:CopyText x:Name="SnapshotPath" VerticalAlignment="Center"/></DockPanel>
       <Expander x:Name="SnapshotMore" Style="{DynamicResource Desk.PathEvidence}" Visibility="Collapsed" Header="{loc:Ui ViewPathDetails}" Margin="0,2,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130" Padding="4,1"><StackPanel>
         <local:CopyText x:Name="SnapshotFull" TextWrapping="Wrap"/>
         <local:CopyText x:Name="SnapshotFullReason" Foreground="{DynamicResource Desk.Muted}" TextWrapping="Wrap" Margin="0,5,0,2"/>
        </StackPanel></ScrollViewer>
       </Expander>
      </StackPanel></StackPanel></Border>
    <DockPanel DockPanel.Dock="Top" Margin="12,3,8,3">
     <Button DockPanel.Dock="Right" x:Name="CompareChanges" Content="{loc:Ui CompareChanges}" Visibility="Collapsed" Click="OpenComparison" Style="{DynamicResource Desk.EvidenceLink}" MinHeight="24" Margin="5,0,0,0" ToolTip="{loc:Ui CompareThePreviousAndNewNameRecordsFor}"/>
     <ComboBox DockPanel.Dock="Left" x:Name="ActivityFilter" SelectedIndex="0" SelectionChanged="FilterChanged" MinWidth="116" MinHeight="24" Padding="5,1" AutomationProperties.Name="{loc:Ui ActivityType}"><ComboBoxItem Content="{loc:Ui AllActivities}"/><ComboBoxItem Content="{loc:Ui NamesAndLocations}"/><ComboBoxItem Content="{loc:Ui CreationAndDeletion}"/><ComboBoxItem Content="{loc:Ui ContentChanges}"/></ComboBox>
     <TextBlock x:Name="Observed" Style="{StaticResource Sub}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
