    <TextBlock x:Name="EmptyActivities" AutomationProperties.LiveSetting="Polite" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,12" Text="{loc:Ui NoActivitiesMatchThisFilter}" Style="{StaticResource Sub}"/>
