<Window x:Class="JournalDesk.IntakeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:JournalDesk"
 Title="{loc:Ui IntakeSettingsTab}" Icon="Assets/NtfsTracer.ico" Width="790" Height="620" MinWidth="600" MinHeight="420"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True" KeyDown="Dismiss"
 Language="{Binding Language,Source={x:Static loc:L.Text}}" FontFamily="Segoe UI, Malgun Gothic"
 Background="{DynamicResource Desk.Canvas}" Foreground="{DynamicResource Desk.Text}">
 <DockPanel>
  <Border x:Name="ProgressBar" DockPanel.Dock="Bottom" Background="{DynamicResource Desk.Panel}" BorderBrush="{DynamicResource Desk.Rule}" BorderThickness="0,1,0,0" Padding="20,6">
   <DockPanel>
    <Button DockPanel.Dock="Right" Click="CancelWork" Content="{loc:Ui IntakeCancel}" Padding="12,3" MinHeight="30" Margin="12,0,0,0"/>
    <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
  <ContentPresenter x:Name="SettingsHost"/>
 </DockPanel>
</Window>
